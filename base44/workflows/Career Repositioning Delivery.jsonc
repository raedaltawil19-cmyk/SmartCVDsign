{
  "name": "Career Repositioning Delivery",
  "description": "\u064a\u0631\u0633\u0644 \u0628\u0631\u064a\u062f\u0627\u064b \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0646\u062f\u0645\u0627 \u062a\u0635\u0628\u062d \u0646\u062a\u064a\u062c\u0629 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0645\u0648\u0636\u0639 \u0627\u0644\u0645\u0647\u0646\u064a \u062c\u0627\u0647\u0632\u0629 \u0648\u0645\u0641\u064a\u062f\u0629\u060c \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u0642\u0637 \u0644\u0643\u0644 \u0646\u062a\u064a\u062c\u0629.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "RepositioningAnalysis",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"ready\" and (.trigger.data.notifiedAt // \"\") == \"\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "career_repositioning_delivery",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_email": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "NotifyRepositioning",
            "args": {
              "analysis_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0625\u0631\u0633\u0627\u0644 \u0628\u0631\u064a\u062f \u0627\u0644\u0646\u062a\u0627\u0626\u062c",
            "description": "\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0644\u0643\u0644 \u0646\u062a\u064a\u062c\u0629"
          }
        }
      }
    ]
  }
}