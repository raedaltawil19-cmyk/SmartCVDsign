    {
      "function_name": "SearchJobs",
      "description": "\u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0648\u0638\u0627\u0626\u0641 \u0645\u062a\u0627\u062d\u0629 \u0641\u064a \u0627\u0644\u0633\u0648\u0642 \u0627\u0644\u0633\u0648\u064a\u062f\u064a. \u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0641\u0642\u0637 \u0639\u0646\u062f\u0645\u0627 \u064a\u0637\u0644\u0628 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0648\u0638\u0627\u0626\u0641 \u0635\u0631\u0627\u062d\u0629\u064b\u061b \u0645\u0645\u0646\u0648\u0639\u0629 \u0641\u064a \u0645\u0633\u0627\u0631 \u062a\u062e\u0635\u064a\u0635/\u0645\u0637\u0627\u0628\u0642\u0629 \u0625\u0639\u0644\u0627\u0646 \u0648\u0638\u064a\u0641\u0629 \u0644\u062f\u0649 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
