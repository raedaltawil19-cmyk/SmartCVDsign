{
  "name": "SavedCV",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string",
      "description": "Visningsnamn f\u00f6r den sparade CV-versionen"
    },
    "data": {
      "type": "object",
      "description": "Hela CV-dataobjektet (cvModel)"
    },
    "templateId": {
      "type": "string",
      "description": "Valt mall-id"
    },
    "layout": {
      "type": "object",
      "description": "Layoutkonfiguration (kolumnordning)"
    },
    "templateSource": {
      "type": "string",
      "enum": [
        "user",
        "auto"
      ],
      "default": "auto",
      "description": "Vem valde mallen: 'user' = anv\u00e4ndaren valde sj\u00e4lv, 'auto' = systemet (templateMatcher) valde"
    },
    "templateReviewStatus": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "skipped"
      ],
      "default": "pending",
      "description": "Status f\u00f6r mallgranskning: 'pending' = ej granskad, 'reviewed' = granskad, 'skipped' = granskning ej till\u00e4mplig (systemvalt mall)"
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "required": []
}