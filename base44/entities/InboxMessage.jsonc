{
  "name": "InboxMessage",
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "description": "\u0627\u062a\u062c\u0627\u0647 \u0627\u0644\u0631\u0633\u0627\u0644\u0629"
    },
    "senderName": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0631\u0633\u0644"
    },
    "senderEmail": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0631\u0633\u0644"
    },
    "recipientEmail": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u062a\u0644\u0645"
    },
    "subject": {
      "type": "string",
      "description": "\u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0631\u0633\u0627\u0644\u0629"
    },
    "body": {
      "type": "string",
      "description": "\u0646\u0635 \u0627\u0644\u0631\u0633\u0627\u0644\u0629"
    },
    "isRead": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u062a\u0645\u062a \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0631\u0633\u0627\u0644\u0629"
    },
    "repliedToMessageId": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u062a\u064a \u062a\u0645 \u0627\u0644\u0631\u062f \u0639\u0644\u064a\u0647\u0627"
    },
    "receivedAt": {
      "type": "string",
      "description": "\u0648\u0642\u062a \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645 \u0623\u0648 \u0627\u0644\u0625\u0631\u0633\u0627\u0644"
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "required": [
    "direction",
    "subject",
    "body"
  ]
}