{
  "name": "RepositioningAnalysis",
  "type": "object",
  "properties": {
    "cvId": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0646\u0633\u062e\u0629 \u0627\u0644\u0633\u064a\u0631\u0629 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u0627\u0644\u062a\u064a \u0628\u064f\u0646\u064a \u0639\u0644\u064a\u0647\u0627 \u0627\u0644\u062a\u062d\u0644\u064a\u0644"
    },
    "cvFingerprint": {
      "type": "string",
      "description": "\u0628\u0635\u0645\u0629 \u0646\u0633\u062e \u0627\u0644\u0633\u064a\u0631\u0629 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u2014 \u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0644\u0645\u0639\u0631\u0641\u0629 \u0623\u0646 \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0623\u0635\u0628\u062d\u062a \u0642\u062f\u064a\u0645\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "ready",
        "no_results",
        "failed"
      ],
      "default": "running",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u062d\u0644\u064a\u0644"
    },
    "trigger": {
      "type": "string",
      "description": "\u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u062a\u064a \u0634\u063a\u0651\u0644\u062a \u0627\u0644\u062a\u062d\u0644\u064a\u0644: save \u0623\u0648 print \u0623\u0648 session_end"
    },
    "startLocation": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0630\u064a \u0628\u062f\u0623 \u0645\u0646\u0647 \u0627\u0644\u0628\u062d\u062b"
    },
    "pathCount": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0633\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0647\u0646\u064a\u0629 \u0627\u0644\u0645\u0643\u062a\u0634\u0641\u0629"
    },
    "jobCount": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0641\u0631\u0635 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629 \u0628\u0639\u062f \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a"
    },
    "result": {
      "type": "object",
      "description": "\u0627\u0644\u0639\u0642\u062f \u0627\u0644\u0645\u0646\u0638\u0645 \u0644\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0648\u0643\u064a\u0644 (\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0645\u0647\u0646\u064a\u060c \u0627\u0644\u0642\u062f\u0631\u0627\u062a\u060c \u0627\u0644\u0645\u0633\u0627\u0631\u0627\u062a\u060c \u0627\u0644\u0645\u0633\u0645\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u0642\u0642\u0629\u060c \u0627\u0644\u0641\u0631\u0635\u060c \u0627\u0644\u0641\u062c\u0648\u0627\u062a\u060c \u0627\u0644\u062f\u0631\u062c\u0627\u062a)"
    },
    "error": {
      "type": "string",
      "description": "\u0633\u0628\u0628 \u0627\u0644\u0641\u0634\u0644 \u0627\u0644\u0622\u0645\u0646 \u0639\u0646\u062f \u0648\u062c\u0648\u062f\u0647"
    },
    "notifiedAt": {
      "type": "string",
      "description": "\u0648\u0642\u062a \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0648\u0627\u0644\u0628\u0631\u064a\u062f \u0644\u062a\u0641\u0627\u062f\u064a \u0627\u0644\u062a\u0643\u0631\u0627\u0631"
    }
  },
  "required": [
    "cvId",
    "cvFingerprint"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}